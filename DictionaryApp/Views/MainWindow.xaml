<Window x:Class="DictionaryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DictionaryApp.ViewModels"
        mc:Ignorable="d"
        Title="Словарь" Height="600" Width="800">
    
    <Window.DataContext>
        <local:DictionaryViewModel/>
    </Window.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Обобщённый словарь" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="5"/>
        
        <!-- Панель информации -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
            <StackPanel>
                <TextBlock Text="Информация о словаре" FontWeight="Bold"/>
                <TextBlock Text="{Binding Count, StringFormat='Количество элементов: {0}'}"/>
                <TextBlock Text="{Binding IsEmpty, StringFormat='Словарь пуст: {0}'}"/>
                <TextBlock Text="{Binding Keys, StringFormat='Ключи: {0}'}"/>
                <TextBlock Text="{Binding Values, StringFormat='Значения: {0}'}"/>
            </StackPanel>
        </Border>
        
        <!-- Добавление элемента -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Добавить элемент" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox Width="150" Margin="5" Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Введите ключ"/>
                <TextBlock Text="→" VerticalAlignment="Center" Margin="5"/>
                <TextBox Width="150" Margin="5" Text="{Binding ValueInput, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Введите значение"/>
                <Button Width="100" Margin="5" Content="Добавить" Command="{Binding AddCommand}"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Проверка наличия ключа -->
        <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Header="Поиск по ключу" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox Width="150" Margin="5" Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Введите ключ для поиска"/>
                <Button Width="100" Margin="5" Content="Найти" Command="{Binding ContainsCommand}"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Удаление элемента -->
        <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="Удалить элемент" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox Width="150" Margin="5" Text="{Binding RemoveKey, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Введите ключ для удаления"/>
                <Button Width="100" Margin="5" Content="Удалить" Command="{Binding RemoveCommand}"/>
                <Button Width="100" Margin="5" Content="Очистить всё" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Список элементов словаря -->
        <GroupBox Grid.Row="5" Grid.ColumnSpan="2" Header="Элементы словаря (ключ : значение)" Margin="5">
            <ListBox ItemsSource="{Binding DictionaryItems}" DisplayMemberPath="Key"/>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </GroupBox>
        
        <!-- Сообщение о результате -->
        <Border Grid.Row="6" Grid.ColumnSpan="2" Background="LightYellow" BorderBrush="Gray" 
                BorderThickness="1" Margin="5" Padding="5">
            <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>